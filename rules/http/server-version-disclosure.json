{
  "id": "server-version-disclosure",
  "version": "1.0.0",
  "kind": "http",
  "title": "Server header discloses software version",
  "description": "The Server header names software and its version, which lets attackers match known vulnerabilities.",
  "severity": "info",
  "confidence": "firm",
  "request": {"method": "HEAD", "path": "/"},
  "match": {"headers": {"Server": "[A-Za-z][A-Za-z0-9_.-]*/\\d"}},
  "negative_status": [200, 204, 301, 302, 303, 307, 308, 401, 403, 404, 405],
  "extract": {"server": {"header": "Server"}},
  "evidence": {"profile": "default"}
}
