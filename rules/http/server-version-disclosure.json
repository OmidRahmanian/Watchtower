{
  "id": "server-version-disclosure",
  "version": "1.0.0",
  "kind": "http",
  "title": "Server header discloses software version",
  "description": "The Server header names software and its version, which lets attackers match known vulnerabilities.",
  "severity": "info",
  "confidence": "firm",
  "request": {
    "method": "HEAD",
    "path": "/"
  },
  "match": {
    "headers": {
      "Server": "[A-Za-z][A-Za-z0-9_.-]*/\\d"
    }
  },
  "negative_status": [
    200,
    204,
    301,
    302,
    303,
    307,
    308,
    401,
    403,
    404,
    405
  ],
  "extract": {
    "server": {
      "header": "Server"
    }
  },
  "evidence": {
    "profile": "default"
  },
  "execution_policy": {
    "source": "WatchTower native rule",
    "license": "MIT",
    "engine": "watchtower-native/1",
    "protocol": "http",
    "requests_per_endpoint": 1,
    "writes_data": false,
    "browser": false,
    "executes_code": false,
    "external_callbacks": false,
    "credentials": false,
    "required_permissions": [
      "operate",
      "authorized_scope"
    ],
    "evidence_policy": "bounded-redacted-excerpt",
    "remediation": "Review banner disclosure; a version banner alone does not prove a vulnerability."
  }
}
